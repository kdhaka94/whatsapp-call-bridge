{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"],
    "paths": {
      "baileys-caller": ["./src/vendor/baileys-caller/dist/index.d.mts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "src/vendor", "test", "vitest.config.ts"]
}
